NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SHOP_NAME=

# Base URL used for metadataBase, sitemap.xml, absolute OG image URLs.
# Update to the real production domain when deployed (Phase 06).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links. Configured via env, not admin-editable (YAGNI).
# Every one is optional — empty vars are filtered out and their icon/button is
# simply not rendered. Each must be a FULL absolute URL (include https://).
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Zalo + Messenger drive the "contact to buy" buttons on product pages.
# With both set, Zalo renders as the primary button; if only one is set, that
# one becomes primary. With neither, a plain "contact the shop" note shows.

# Zalo: https://zalo.me/<phone> — drop the leading 0 and prefix 84, or use the
# number as-is (both forms are accepted). Zalo OA: open the OA, ⋮ → share to
# get its link. Note: a phone-number link publicly exposes that number.
# Example: https://zalo.me/84909123456
NEXT_PUBLIC_ZALO_URL=

# Messenger: https://m.me/<page-username> — the Page *username* (no spaces),
# found in Page Settings → Username, not the display name.
# The app appends a `ref` query param carrying the product name.
# Example: https://m.me/camerashop
NEXT_PUBLIC_MESSENGER_URL=

# Local-only: Postgres connection string for psql/debugging.
# NOT used by the app at runtime. Keep out of git (.env* is gitignored).
# Format: postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
